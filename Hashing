#include <stdio.h>          // For input/output functions

#define SIZE 10             // Size of the hash table

int hashTable[SIZE];        // Hash table array

// Function to initialize hash table with -1 (indicates empty slots)
void initHashTable() {
    for (int i = 0; i < SIZE; i++)
        hashTable[i] = -1;  // Set all slots to -1
}

// Hash function: returns index by taking modulo of key with table size
int hashFunction(int key) {
    return key % SIZE;
}

// Function to insert a key using linear probing for collision resolution
void insert(int key) {
    int index = hashFunction(key);         // Calculate hash index
    int i = 0;                              // Iterator for probing

    // Find next available slot using linear probing
    while (hashTable[(index + i) % SIZE] != -1) {
        i++;
        if (i == SIZE) {                   // If table is full
            printf("Hash table is full!\n");
            return;
        }
    }

    // Insert key in the empty slot found
    hashTable[(index + i) % SIZE] = key;
}

// Function to search for a key using linear probing
int search(int key) {
    int index = hashFunction(key);         // Calculate starting index
    int i = 0;                              // Iterator for probing

    // Search through the table until key is found or a -1 is encountered
    while (hashTable[(index + i) % SIZE] != -1 && i < SIZE) {
        if (hashTable[(index + i) % SIZE] == key)
            return (index + i) % SIZE;     // Key found, return index
        i++;
    }

    return -1;                             // Key not found
}

// Function to display the current state of the hash table
void display() {
    printf("Hash Table:\n");
    for (int i = 0; i < SIZE; i++)
        printf("%d => %d\n", i, hashTable[i]);   // Print each index and its value
}

int main() {
    initHashTable();               // Initialize hash table

    insert(23);                    // Insert key 23
    insert(43);                    // Insert key 43
    insert(13);                    // Insert key 13
    insert(27);                    // Insert key 27

    display();                     // Display the table

    int key = 43;                  // Key to search
    int pos = search(key);        // Search for key 43

    // Print search result
    if (pos != -1)
        printf("Key %d found at index %d\n", key, pos);
    else
        printf("Key %d not found!\n", key);

    return 0;                      // End of program
}
