#include <stdio.h>      // Standard I/O functions
#include <stdlib.h>     // For malloc and free

// Define structure of AVL tree node
struct Node {
    int key;            // Value of the node
    struct Node* left;  // Pointer to left child
    struct Node* right; // Pointer to right child
    int height;         // Height of the node in the tree
};

// Function to get height of a node
int height(struct Node* N) {
    if (N == NULL)      // If node is NULL, height is 0
        return 0;
    return N->height;   // Otherwise return its height
}

// Function to get the maximum of two integers
int max(int a, int b) {
    return (a > b) ? a : b;   // Return greater of a or b
}

// Function to create a new node with a given key
struct Node* newNode(int key) {
    struct Node* node = (struct Node*) malloc(sizeof(struct Node)); // Allocate memory
    node->key = key;        // Set key
    node->left = NULL;      // Initialize left child to NULL
    node->right = NULL;     // Initialize right child to NULL
    node->height = 1;       // New node is a leaf node, height = 1
    return node;
}

// Function to perform right rotation
struct Node* rightRotate(struct Node* y) {
    struct Node* x = y->left;   // x becomes new root
    struct Node* T2 = x->right; // Store x's right subtree

    // Perform rotation
    x->right = y;       // y becomes right child of x
    y->left = T2;       // T2 becomes left child of y

    // Update heights
    y->height = max(height(y->left), height(y->right)) + 1; // Update y’s height
    x->height = max(height(x->left), height(x->right)) + 1; // Update x’s height

    return x;   // Return new root
}

// Function to perform left rotation
struct Node* leftRotate(struct Node* x) {
    struct Node* y = x->right;  // y becomes new root
    struct Node* T2 = y->left;  // Store y's left subtree

    // Perform rotation
    y->left = x;        // x becomes left child of y
    x->right = T2;      // T2 becomes right child of x

    // Update heights
    x->height = max(height(x->left), height(x->right)) + 1; // Update x’s height
    y->height = max(height(y->left), height(y->right)) + 1; // Update y’s height

    return y;   // Return new root
}

// Function to get balance factor of a node
int getBalance(struct Node* N) {
    if (N == NULL)      // Null node has 0 balance
        return 0;
    return height(N->left) - height(N->right);  // Difference of left and right subtree heights
}

// Function to insert a key in the AVL tree
struct Node* insert(struct Node* node, int key) {
    // Perform normal BST insertion
    if (node == NULL)
        return newNode(key);   // Create new node if null

    if (key < node->key)       // If key is less, insert in left subtree
        node->left = insert(node->left, key);
    else if (key > node->key)  // If key is more, insert in right subtree
        node->right = insert(node->right, key);
    else
        return node;           // Duplicate keys not allowed

    // Update height of the ancestor node
    node->height = 1 + max(height(node->left), height(node->right));

    // Get balance factor to check whether this node became unbalanced
    int balance = getBalance(node);

    // Balancing the node based on balance factor and insertion case

    // Case 1 - Left Left (LL Rotation)
    if (balance > 1 && key < node->left->key)
        return rightRotate(node);

    // Case 2 - Right Right (RR Rotation)
    if (balance < -1 && key > node->right->key)
        return leftRotate(node);

    // Case 3 - Left Right (LR Rotation)
    if (balance > 1 && key > node->left->key) {
        node->left = leftRotate(node->left);    // First do left rotation on left child
        return rightRotate(node);               // Then do right rotation on node
    }

    // Case 4 - Right Left (RL Rotation)
    if (balance < -1 && key < node->right->key) {
        node->right = rightRotate(node->right); // First do right rotation on right child
        return leftRotate(node);                // Then do left rotation on node
    }

    // Return the (unchanged) node pointer
    return node;
}

// Function to print in-order traversal of AVL Tree
void inorder(struct Node* root) {
    if (root != NULL) {
        inorder(root->left);        // Traverse left subtree
        printf("%d ", root->key);   // Print current node key
        inorder(root->right);       // Traverse right subtree
    }
}

// Main function (Driver Code)
int main() {
    struct Node* root = NULL;   // Initialize AVL Tree root as NULL

    // Insert elements into the AVL tree
    root = insert(root, 30);
    root = insert(root, 20);
    root = insert(root, 10);  // Triggers right rotation (LL case)
    root = insert(root, 25);
    root = insert(root, 40);
    root = insert(root, 50);  // Triggers left rotation (RR case)
    root = insert(root, 22);  // Triggers Left-Right rotation (LR case)

    // Print in-order traversal of AVL Tree
    printf("Inorder traversal of balanced AVL Tree:\n");
    inorder(root);
    printf("\n");

    return 0;
}
